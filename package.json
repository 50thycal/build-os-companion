{
  "name": "@build-os/companion",
  "version": "0.1.0",
  "private": true,
  "description": "Project intelligence companion for Build OS: normalized event ledger, state projection, attention engine, and feed.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
