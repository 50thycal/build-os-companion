    "test:watch": "vitest",
    "sync": "node --experimental-strip-types src/cli/sync.ts",
    "demo": "node --experimental-strip-types src/cli/demo.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
